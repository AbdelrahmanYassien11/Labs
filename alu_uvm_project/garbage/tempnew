

//---------------------------------------
// Test focused on Set A operations
//---------------------------------------
class alu_set_a_test extends alu_base_test;
  
  // Register with factory
  `uvm_component_utils(alu_set_a_test)
  
  // Sequence instance
  alu_set_a_sequence seq;
  
  //---------------------------------------
  // Constructor
  //---------------------------------------
  function new(string name = "alu_set_a_test", uvm_component parent = null);
    super.new(name, parent);
  endfunction : new
  
  //---------------------------------------
  // Run phase
  //---------------------------------------
  task run_phase(uvm_phase phase);
    // Raise objection to keep the test from completing
    phase.raise_objection(this);
    
    `uvm_info(get_type_name(), "Set A operations test started", UVM_MEDIUM)
    
    // Create and start sequence
    seq = alu_set_a_sequence::type_id::create("seq");
    seq.start(env.alu_agnt.sequencer);
    
    // Wait for potential backdoor operations to complete
    #100;
    
    `uvm_info(get_type_name(), "Set A operations test completed", UVM_MEDIUM)
    
    // Drop objection to allow the test to complete
    phase.drop_objection(this);
  endtask : run_phase
  
endclass : alu_set_a_test

