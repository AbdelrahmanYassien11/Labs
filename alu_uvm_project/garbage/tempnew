//---------------------------------------
// Test for regression - runs multiple sequences
//---------------------------------------
class alu_regression_test extends alu_base_test;
  
  // Register with factory
  `uvm_component_utils(alu_regression_test)
  
  // Sequence instances
  alu_sequence rand_seq;
  alu_set_a_sequence set_a_seq;
  alu_set_b1_sequence set_b1_seq;
  alu_set_b2_sequence set_b2_seq;
  alu_negative_sequence neg_seq;
  
  //---------------------------------------
  // Constructor
  //---------------------------------------
  function new(string name = "alu_regression_test", uvm_component parent = null);
    super.new(name, parent);
  endfunction : new
  
  //---------------------------------------
  // Run phase
  //---------------------------------------
  task run_phase(uvm_phase phase);
    // Raise objection to keep the test from completing
    phase.raise_objection(this);
    
    `uvm_info(get_type_name(), "Regression test started", UVM_MEDIUM)
    
    // Create and start random sequence
    rand_seq = alu_sequence::type_id::create("rand_seq");
    rand_seq.start(env.alu_agnt.sequencer);
    
    // Create and start set A sequence
    set_a_seq = alu_set_a_sequence::type_id::create("set_a_seq");
    set_a_seq.start(env.alu_agnt.sequencer);
    
    // Create and start set B1 sequence
    set_b1_seq = alu_set_b1_sequence::type_id::create("set_b1_seq");
    set_b1_seq.start(env.alu_agnt.sequencer);
    
    // Create and start set B2 sequence
    set_b2_seq = alu_set_b2_sequence::type_id::create("set_b2_seq");
    set_b2_seq.start(env.alu_agnt.sequencer);
    
    // Create and start negative sequence
    neg_seq = alu_negative_sequence::type_id::create("neg_seq");
    neg_seq.start(env.alu_agnt.sequencer);
    
    // Wait for potential backdoor operations to complete
    #100;
    
    `uvm_info(get_type_name(), "Regression test completed", UVM_MEDIUM)
    
    // Drop objection to allow the test to complete
    phase.drop_objection(this);
  endtask : run_phase
  
endclass : alu_regression_test